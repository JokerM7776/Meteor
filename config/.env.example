# Copy to .env in the repository root. Process environment overrides this file.
APP_URL=http://localhost:8000
APP_ENV=development
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meteor
DB_USER=meteor
DB_PASS=
# Relative to the repository root; used only for sqlite.
DB_PATH=storage/meteor.sqlite
SESSION_NAME=meteor_session
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Meteor
