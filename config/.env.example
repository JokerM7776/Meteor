# Copy to .env in the repository root. Process environment overrides this file.
APP_URL=http://localhost:8000
APP_ENV=development
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meteor
DB_USER=meteor
DB_PASS=
# Relative to the repository root; used only for sqlite.
DB_PATH=storage/meteor.sqlite
SESSION_NAME=meteor_session
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Meteor
# Set to off to skip Cloudflare Turnstile on the sign-in page, e.g. when a wrong key locks you out.
# TURNSTILE=off

# Optional: install without the web form (for hosts whose firewall blocks it).
# Fill in the settings above and these lines, upload this file as .env next to VERSION,
# then open the site once. Meteor installs itself and deletes ADMIN_USER and ADMIN_PASS
# from .env. Set APP_URL to your site address (e.g. https://example.com); the password
# needs 12+ characters.
# ADMIN_USER=admin
# ADMIN_PASS=
# SITE_TITLE=Meteor
