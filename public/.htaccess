# mod_rewrite refuses to run in .htaccess unless symlink following is on (403 otherwise).
Options -Indexes -MultiViews +SymLinksIfOwnerMatch
DirectoryIndex index.php
RewriteEngine On
# Uploaded content must never execute as PHP.
RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
